{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [],
    "baseUrl": "../..",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"]
}
