# pnpm setup:local writes .env.local with a random capability key.
APP_ENV=local
# Owned Warmane relay (required in production; keep the secret server-side).
WARMANE_RELAY_URL=
WARMANE_RELAY_SECRET=
# Owned item tooltip JSON service (server-only).
ITEM_TOOLTIP_RELAY_URL=
ITEM_TOOLTIP_RELAY_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://127.0.0.1:55435/wow_top_gear
CAPABILITY_KEY=
TOP_GEAR_ITERATIONS=500
TOP_GEAR_MAX_UNITS=600000
TOP_GEAR_MAX_SECONDS=900
GLOBAL_DAILY_UNITS=10000000
MAX_QUEUED_JOBS=20
# SIM_BINARY=/absolute/path/to/dist/simulator/local/wowsimcli
# Public deployments must use a proxy that OVERWRITES this header.
# TRUSTED_IP_HEADER=
TRIGGER_PROJECT_REF=proj_tbzzdkaotlbspettqxxh
# TRIGGER_SECRET_KEY=

# Direct PostgreSQL session for migrations; mandatory with a pooled runtime URL.
# DATABASE_URL_UNPOOLED=
# Stable auth secret and Discord app credentials are server-only.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
AUTH_ENROLLMENT_ENABLED=false
REPORT_SAVING_ENABLED=false
